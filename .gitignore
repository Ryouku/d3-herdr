# Only our own layout and mods are versioned here. Everything else in this
# folder is Herdr's, bettr's (~/.local/share/bettr) or state the app writes.
/*
!/.gitignore
!/README.md
!/layouts/
/layouts/*
!/layouts/my-bettr.json
!/mods/
/mods/*
!/mods/bell/
!/keys.json
!/mods/my-spaces/
!/mods/my-usage/
!/mods/resource-monitor/
!/mods/herdr-sim/
!/mods/herdr-sim-screen/
# Simulator frames the herdr-sim mod writes at runtime.
/mods/herdr-sim-screen/*.jpg
# Written into mod folders by Herdr.
jsconfig.json
*.d.ts
